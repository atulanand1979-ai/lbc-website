---
layout: layouts/base.njk
title: Set Your Password
permalink: /account/set-password.html
noindex: true
scripts: ["/js/password.js"]
---
<section class="section">
  <div class="container split" style="align-items:flex-start">
    <div class="section__head">
      <span class="eyebrow">My account</span>
      <h1 style="font-size:clamp(40px,6vw,64px)">Set your password</h1>
      <p class="prose">Choose a password of at least 10 characters. You'll be signed in straight away.</p>
    </div>
    <form id="set-password-form" class="form form-panel" novalidate>
      <div class="field"><label for="p-1">New password</label><input id="p-1" name="password" type="password" autocomplete="new-password" minlength="10" required></div>
      <div class="field"><label for="p-2">Confirm password</label><input id="p-2" name="confirm" type="password" autocomplete="new-password" minlength="10" required></div>
      <div class="alert" data-message hidden></div>
      <div><button class="btn btn--yellow-outline" type="submit">Save password</button></div>
      <p class="small muted">Link expired? <a href="/account/forgot.html">Get a new one</a>.</p>
    </form>
  </div>
</section>
