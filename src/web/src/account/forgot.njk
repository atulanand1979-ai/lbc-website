---
layout: layouts/base.njk
title: Reset Password
permalink: /account/forgot.html
noindex: true
scripts: ["/js/password.js"]
---
<section class="section">
  <div class="container split" style="align-items:flex-start">
    <div class="section__head">
      <span class="eyebrow">My account</span>
      <h1 style="font-size:clamp(40px,6vw,64px)">Get a sign-in link</h1>
      <p class="prose">Enter the email you booked or joined with. We'll send you a link to set a new password.</p>
    </div>
    <form id="forgot-form" class="form form-panel" novalidate>
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required></div>
      <div class="alert" data-message hidden></div>
      <div><button class="btn btn--yellow-outline" type="submit">Send link</button></div>
    </form>
  </div>
</section>
